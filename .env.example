# Copy this file to backend/.env.local and fill in the values. Never commit .env.local.
# Every value here is server-only. Nothing uses the NEXT_PUBLIC_ prefix,
# so no key is ever sent to the browser.

# Supabase: https://supabase.com/dashboard/project/qjtolrswazbmcureevta/settings/api-keys
SUPABASE_URL=https://qjtolrswazbmcureevta.supabase.co
# Read-only access. Row-level security still applies.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Full access. Bypasses row-level security. Used for writes, loading data/, and texting.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Gemini: https://aistudio.google.com/apikey
# Training plans and the iMessage chatbot. Plans still work without it.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Coaches type this to generate plans and change the live rotation.
COACH_PASSCODE=choose_a_long_passcode

# Photon Spectrum: https://app.photon.codes -> project Settings
# Used by the messaging/ service to text players over iMessage.
SPECTRUM_PROJECT_ID=your_spectrum_project_id_here
SPECTRUM_PROJECT_SECRET=your_spectrum_project_secret_here
# Hour (0-23, server local time) to text players their unfinished drills.
REMINDER_HOUR=17

# Vercel: only needed to deploy from the terminal or CI. Not used by the app.
# Token: https://vercel.com/account/tokens
# Org and project IDs: Project -> Settings -> General, or .vercel/project.json after `npx vercel link`
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_vercel_org_id_here
VERCEL_PROJECT_ID=your_vercel_project_id_here
