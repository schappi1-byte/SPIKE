# The frontend needs no keys. GEMINI_API_KEY, GEMINI_MODEL, and the Supabase keys are read by the
# Next.js server from backend/.env.local (or the Vercel dashboard). Never prefix them with VITE_.
# Optional: where `pnpm dev` forwards /api requests. Defaults to the Next.js dev server.
SPIKE_API_URL=http://localhost:3000
